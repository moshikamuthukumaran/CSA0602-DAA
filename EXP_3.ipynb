      "cell_type": "code",
      "source": [
        "def rec(n):\n",
        "    if n==0:return 1\n",
        "    return n*rec(n-1)\n",
        "\n",
        "n=5\n",
        "f=1\n",
        "for i in range(1,n+1):f*=i\n",
        "print(\"Iterative:\",f)\n",
        "print(\"Recursive:\",rec(n))"
      ],
