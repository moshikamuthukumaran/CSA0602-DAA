      "source": [
        "def hanoi(n,a,b,c):\n",
        "    if n:\n",
        "        hanoi(n-1,a,c,b)\n",
        "        print(a,\"->\",c)\n",
        "        hanoi(n-1,b,a,c)\n",
        "\n",
        "hanoi(3,\"A\",\"B\",\"C\")"
      ],
