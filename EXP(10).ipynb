      "source": [
        "a=[12,11,13,5,6]\n",
        "\n",
        "for i in range(1,len(a)):\n",
        "    x=a[i]\n",
        "    j=i-1\n",
        "    while j>=0 and a[j]>x:\n",
        "        a[j+1]=a[j]\n",
        "        j-=1\n",
        "    a[j+1]=x\n",
        "\n",
        "print(a)"
      ],
