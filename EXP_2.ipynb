      "cell_type": "code",
      "source": [
        "def bs(a,l,r,x):\n",
        "    if l>r:return -1\n",
        "    m=(l+r)//2\n",
        "    if a[m]==x:return m\n",
        "    if x<a[m]:return bs(a,l,m-1,x)\n",
        "    return bs(a,m+1,r,x)\n",
        "\n",
        "a=[5,10,15,20,25]\n",
        "print(\"Key found at index\",bs(a,0,4,20))"
      ],
      "metadata": {
