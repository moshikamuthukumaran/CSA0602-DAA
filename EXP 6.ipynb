      "cell_type": "code",
      "source": [
        "def merge(a):\n",
        "    if len(a)>1:\n",
        "        m=len(a)//2\n",
        "        L=merge(a[:m])\n",
        "        R=merge(a[m:])\n",
        "        a=[]\n",
        "        while L and R:\n",
        "            a.append((L if L[0]<R[0] else R).pop(0))\n",
        "        a+=L+R\n",
        "        return a\n",
        "    return a\n",
        "\n",
        "print(merge([38,27,43,3,9,82,10]))"
      ],
      "metadata": {
