      "cell_type": "code",
      "source": [
        "def quick(a):\n",
        "    if len(a)<=1:return a\n",
        "    p=a[0]\n",
        "    return quick([x for x in a[1:] if x<p])+[p]+quick([x for x in a[1:] if x>=p])\n",
        "\n",
        "print(quick([10,7,8,9,1,5]))"
      ],
      "metadata": {
