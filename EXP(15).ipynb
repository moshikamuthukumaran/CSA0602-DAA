      "source": [
        "from math import sqrt\n",
        "\n",
        "p=[(1,2),(4,5),(7,8),(3,1)]\n",
        "d=999\n",
        "\n",
        "for i in range(4):\n",
        "    for j in range(i+1,4):\n",
        "        x=(p[i][0]-p[j][0])**2+(p[i][1]-p[j][1])**2\n",
        "        if x<d:d=x; pair=(p[i],p[j])\n",
        "\n",
        "print(pair,sqrt(d))"
      ],
