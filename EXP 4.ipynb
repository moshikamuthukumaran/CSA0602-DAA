      "source": [
        "def fib(n):\n",
        "    if n<=1:return n\n",
        "    return fib(n-1)+fib(n-2)\n",
        "\n",
        "n=6\n",
        "a=[fib(i) for i in range(n)]\n",
        "print(a)"
      ],
